<!-- Light mode: soft lavender. Same keys as Dark.xaml; ThemeManager swaps the two. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Bg" Color="#F5F3FA" />
  <SolidColorBrush x:Key="Sidebar" Color="#EDE9F6" />
  <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
  <SolidColorBrush x:Key="PanelRaised" Color="#EFEBF8" />
  <SolidColorBrush x:Key="Border" Color="#DDD6EC" />
  <SolidColorBrush x:Key="BorderStrong" Color="#B9AFD3" />
  <SolidColorBrush x:Key="Text" Color="#1C1630" />
  <SolidColorBrush x:Key="TextSoft" Color="#3A3352" />
  <SolidColorBrush x:Key="TextMuted" Color="#655D7E" />
  <SolidColorBrush x:Key="Current" Color="#E6DEFA" />
  <SolidColorBrush x:Key="Record" Color="#C93636" />
  <SolidColorBrush x:Key="DangerBorder" Color="#EBC2C2" />
  <SolidColorBrush x:Key="Warning" Color="#9A6200" />
  <SolidColorBrush x:Key="WarningSoft" Color="#FFF6E5" />
  <SolidColorBrush x:Key="WarningBorder" Color="#F0D9A8" />
  <SolidColorBrush x:Key="Success" Color="#16A34A" />
  <SolidColorBrush x:Key="Overlay" Color="#801C1630" />
  <SolidColorBrush x:Key="Accent" Color="#A78BFA" />
  <SolidColorBrush x:Key="AccentText" Color="#140B2E" />
  <SolidColorBrush x:Key="AccentLink" Color="#6D4FD0" />
  <SolidColorBrush x:Key="AccentSoft" Color="#F0EBFF" />
  <SolidColorBrush x:Key="AccentSoftBorder" Color="#D4C8F7" />
</ResourceDictionary>
