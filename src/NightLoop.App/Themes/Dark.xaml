<!-- Dark mode: the deep purple of the icon's night sky. Same keys as Light.xaml; ThemeManager swaps the two. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Bg" Color="#110D1A" />
  <SolidColorBrush x:Key="Sidebar" Color="#150F21" />
  <SolidColorBrush x:Key="Panel" Color="#1A1428" />
  <SolidColorBrush x:Key="PanelRaised" Color="#241C37" />
  <SolidColorBrush x:Key="Border" Color="#30264A" />
  <SolidColorBrush x:Key="BorderStrong" Color="#4A3D6B" />
  <SolidColorBrush x:Key="Text" Color="#EEEAF6" />
  <SolidColorBrush x:Key="TextSoft" Color="#D2CCE3" />
  <SolidColorBrush x:Key="TextMuted" Color="#9C93B5" />
  <SolidColorBrush x:Key="Current" Color="#2B2145" />
  <SolidColorBrush x:Key="Record" Color="#F26B6B" />
  <SolidColorBrush x:Key="DangerBorder" Color="#5C2A3A" />
  <SolidColorBrush x:Key="Warning" Color="#F0B44C" />
  <SolidColorBrush x:Key="WarningSoft" Color="#2A2014" />
  <SolidColorBrush x:Key="WarningBorder" Color="#5A4320" />
  <SolidColorBrush x:Key="Success" Color="#3DD68C" />
  <SolidColorBrush x:Key="Overlay" Color="#B30A0712" />
  <!-- Accent defaults; ThemeManager replaces these with the accent picked in Settings. -->
  <SolidColorBrush x:Key="Accent" Color="#A78BFA" />
  <SolidColorBrush x:Key="AccentText" Color="#140B2E" />
  <SolidColorBrush x:Key="AccentLink" Color="#A78BFA" />
  <SolidColorBrush x:Key="AccentSoft" Color="#221A38" />
  <SolidColorBrush x:Key="AccentSoftBorder" Color="#3D3163" />
</ResourceDictionary>
