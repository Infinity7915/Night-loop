<UserControl x:Class="NightLoop.App.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NightLoop.App.ViewModels">
  <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
    <Border Style="{StaticResource Card}" Width="420" Padding="32,28" Margin="0,40"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel>
        <Image Source="/Assets/icon.png" Width="56" Height="56" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Margin="0,16,0,4" />
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" TextWrapping="Wrap" />

        <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentSoftBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,16,0,0"
                Visibility="{Binding Notice, Converter={StaticResource TextToVisible}}">
          <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
        </Border>

        <!-- Email: sign in, sign up, forgot -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:AuthMode.Code}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:AuthMode.Reset}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="254" />
          <TextBlock Text="{Binding EmailError}" Style="{StaticResource FieldError}"
                     Visibility="{Binding EmailError, Converter={StaticResource TextToVisible}}" />
        </StackPanel>

        <!-- Code: after sign-in/sign-up, and for password reset -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:AuthMode.Code}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:AuthMode.Reset}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="6-digit code" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="CodeBox" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="6"
                   FontFamily="{StaticResource Mono}" FontSize="22" HorizontalContentAlignment="Center" />
          <TextBlock Text="{Binding CodeError}" Style="{StaticResource FieldError}"
                     Visibility="{Binding CodeError, Converter={StaticResource TextToVisible}}" />
          <CheckBox Content="Trust this PC for 30 days" IsChecked="{Binding TrustThisPc}" Margin="0,12,0,0"
                    Visibility="{Binding CodeIsForSignIn, Converter={StaticResource BoolToVisible}}" />
          <Button Content="Send a new code" Command="{Binding ResendCommand}" Style="{StaticResource LinkButton}" Margin="0,12,0,0"
                  HorizontalAlignment="Left" Visibility="{Binding IsCode, Converter={StaticResource BoolToVisible}}" />
        </StackPanel>

        <!-- Password: sign in, sign up, reset -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:AuthMode.Code}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:AuthMode.Forgot}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
          <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" MaxLength="128" />
          <StackPanel Visibility="{Binding IsSignIn, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}">
            <TextBlock Text="Confirm password" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="ConfirmBox" PasswordChanged="OnConfirmChanged" MaxLength="128" />
          </StackPanel>
          <TextBlock Text="{Binding PasswordError}" Style="{StaticResource FieldError}"
                     Visibility="{Binding PasswordError, Converter={StaticResource TextToVisible}}" />
          <Button Content="Forgot password?" Command="{Binding ShowCommand}" CommandParameter="{x:Static vm:AuthMode.Forgot}"
                  Style="{StaticResource LinkButton}" Margin="0,10,0,0" HorizontalAlignment="Left"
                  Visibility="{Binding IsSignIn, Converter={StaticResource BoolToVisible}}" />
          <!-- The box ticks; the blue line opens the Terms of Service on GitHub. -->
          <DockPanel Margin="0,14,0,0" Visibility="{Binding IsSignUp, Converter={StaticResource BoolToVisible}}">
            <CheckBox x:Name="TermsBox" DockPanel.Dock="Left" IsChecked="{Binding AcceptedTerms}" VerticalAlignment="Top" Margin="0,1,8,0"
                      AutomationProperties.Name="Agree to the Terms of Service" ToolTip="Tick to agree" />
            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="19">
              <Hyperlink Click="OnTermsClick" Foreground="#3B82F6" ToolTip="Opens the Night-loop Terms of Service on GitHub">Click to agree: I'm at least 13 and accept the Night-loop Terms of Service and Privacy Policy</Hyperlink>
            </TextBlock>
          </DockPanel>
        </StackPanel>

        <TextBlock Text="{Binding FormError}" Style="{StaticResource FieldError}" Margin="0,14,0,0"
                   Visibility="{Binding FormError, Converter={StaticResource TextToVisible}}" />

        <!-- Primary action per mode -->
        <Grid Margin="0,22,0,0">
          <Button Style="{StaticResource PrimaryButton}" Margin="0" IsDefault="True" Command="{Binding SignInCommand}"
                  Visibility="{Binding IsSignIn, Converter={StaticResource BoolToVisible}}">
            <TextBlock Text="Sign in" Foreground="{DynamicResource AccentText}" />
          </Button>
          <Button Style="{StaticResource PrimaryButton}" Margin="0" IsDefault="True" Command="{Binding SignUpCommand}"
                  Visibility="{Binding IsSignUp, Converter={StaticResource BoolToVisible}}">
            <TextBlock Text="Create account" Foreground="{DynamicResource AccentText}" />
          </Button>
          <Button Style="{StaticResource PrimaryButton}" Margin="0" IsDefault="True" Command="{Binding VerifyCodeCommand}"
                  Visibility="{Binding IsCode, Converter={StaticResource BoolToVisible}}">
            <TextBlock Text="Continue" Foreground="{DynamicResource AccentText}" />
          </Button>
          <Button Style="{StaticResource PrimaryButton}" Margin="0" IsDefault="True" Command="{Binding ForgotCommand}"
                  Visibility="{Binding IsForgot, Converter={StaticResource BoolToVisible}}">
            <TextBlock Text="Send code" Foreground="{DynamicResource AccentText}" />
          </Button>
          <Button Style="{StaticResource PrimaryButton}" Margin="0" IsDefault="True" Command="{Binding ResetCommand}"
                  Visibility="{Binding IsReset, Converter={StaticResource BoolToVisible}}">
            <TextBlock Text="Change password" Foreground="{DynamicResource AccentText}" />
          </Button>
        </Grid>
        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" Foreground="{DynamicResource Accent}"
                     Background="Transparent" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />

        <!-- Switch between screens -->
        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsSignIn, Converter={StaticResource BoolToVisible}}">
            <TextBlock Text="New to Night-loop? " Style="{StaticResource Muted}" />
            <Button Content="Create an account" Command="{Binding ShowCommand}" CommandParameter="{x:Static vm:AuthMode.SignUp}"
                    Style="{StaticResource LinkButton}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsSignIn, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}">
            <Button Content="{Binding BackText}" Command="{Binding BackCommand}" Style="{StaticResource LinkButton}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
