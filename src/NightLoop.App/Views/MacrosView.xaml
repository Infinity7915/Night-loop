<UserControl x:Class="NightLoop.App.Views.MacrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NightLoop.App.ViewModels">
  <DockPanel Margin="32,24,32,20">
    <Grid DockPanel.Dock="Top">
      <StackPanel>
        <TextBlock Text="MACROS" Style="{StaticResource Eyebrow}" />
        <TextBlock Text="Macros" FontSize="30" FontWeight="Bold" Margin="0,4,0,2" />
        <TextBlock Text="Record what you do, then replay it." Style="{StaticResource Muted}" FontSize="14" />
      </StackPanel>
      <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource DangerButton}"
              Command="{Binding StopAllCommand}">
        <TextBlock Foreground="{DynamicResource Record}">
          <Run Text="Stop all · " /><Run Text="{Binding PanicHotkeyText, Mode=OneWay}" />
        </TextBlock>
      </Button>
    </Grid>

    <!-- Target game banner -->
    <Border DockPanel.Dock="Top" Margin="0,18,0,0" Padding="16,10" CornerRadius="10"
            Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentSoftBorder}" BorderThickness="1">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Change target" VerticalAlignment="Center"
                Command="{Binding ChangeTargetCommand}" IsEnabled="{Binding IsRecording, Converter={StaticResource Not}}" />
        <TextBlock DockPanel.Dock="Left" Text="&#xE7B3;" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource AccentLink}"
                   VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Text="{Binding Games.Banner}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Style="{StaticResource Card}" Padding="14,8">
      <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
    </Border>

    <!-- Saved macros on the account -->
    <Border DockPanel.Dock="Left" Width="260" Margin="0,16,16,0" Style="{StaticResource Card}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="16,14,12,10">
          <StackPanel>
            <TextBlock Text="SAVED MACROS" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="{Binding UsedText}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
          </StackPanel>
          <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="+ New" Command="{Binding NewMacroCommand}" />
        </Grid>
        <Grid>
          <ListBox ItemsSource="{Binding SavedMacros}" SelectedItem="{Binding SelectedSaved}" Background="Transparent"
                   BorderThickness="0" Padding="8,0,8,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Row" CornerRadius="8" Padding="10,8" Margin="0,1" Background="Transparent" Cursor="Hand">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Row" Property="Background" Value="{DynamicResource Current}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Row" Property="Background" Value="{DynamicResource PanelRaised}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:SavedMacroRow}">
                <StackPanel ToolTip="{Binding Name}">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Eyebrow}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="Nothing saved yet. Your first recording lands here." Style="{StaticResource Muted}"
                     TextWrapping="Wrap" Margin="16,0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
            <TextBlock.Visibility>
              <Binding Path="SavedMacros.Count" Converter="{StaticResource ZeroToVisible}" />
            </TextBlock.Visibility>
          </TextBlock>
        </Grid>
      </DockPanel>
    </Border>

    <!-- Loaded macro card -->
    <Border Margin="0,16,0,0" Style="{StaticResource Card}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="20,16">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="LOADED MACRO" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
              <Border Style="{StaticResource Chip}" Width="Auto" Margin="10,0,0,0" BorderBrush="{DynamicResource Border}">
                <TextBlock Text="{Binding SyncText}" Style="{StaticResource Eyebrow}" />
              </Border>
            </StackPanel>
            <TextBox Text="{Binding MacroName, UpdateSourceTrigger=PropertyChanged}" FontSize="18" FontWeight="SemiBold"
                     Width="320" HorizontalAlignment="Left" Margin="0,6,0,0" MaxLength="60" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Command="{Binding ImportCommand}" Content="Import" />
            <Button Command="{Binding ExportCommand}" Content="Export" />
            <Button Command="{Binding DeleteCommand}" Content="Delete" />
            <Button Command="{Binding SaveCommand}" Content="Save" />
            <Button Command="{Binding ToggleRecordCommand}" Margin="18,0,0,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="{DynamicResource Record}" Margin="0,0,8,0" />
                <TextBlock>
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="Record" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                          <Setter Property="Text" Value="Stop recording" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding RecordHotkeyText}" Style="{StaticResource Eyebrow}" Margin="8,2,0,0" />
              </StackPanel>
            </Button>
            <Button Command="{Binding TogglePlayCommand}" Style="{StaticResource PrimaryButton}" MinWidth="96">
              <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="{DynamicResource AccentText}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="Play" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                          <Setter Property="Text" Value="Stop" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding PlayHotkeyText}" FontFamily="{StaticResource Mono}" FontSize="11"
                           Foreground="{DynamicResource AccentText}" Opacity="0.7" Margin="8,2,0,0" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <!-- Options row -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,1" Padding="20,10">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding BlockSummary}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal">
              <CheckBox Content="Record mouse movement" IsChecked="{Binding RecordMouseMoves}" Margin="0,0,20,0" />
              <TextBlock Text="Repeat" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox Text="{Binding RepeatCount}" Width="64" IsEnabled="{Binding RepeatForever, Converter={StaticResource Not}}" />
              <CheckBox Content="Forever" IsChecked="{Binding RepeatForever}" Margin="8,0,20,0" />
              <CheckBox Content="Humanize" IsChecked="{Binding Humanize}" FontWeight="SemiBold" />
              <TextBlock Text="Timing ±" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,6,0" />
              <TextBox Text="{Binding TimingJitterPct}" Width="48" />
              <TextBlock Text="%" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,12,0" />
              <TextBlock Text="Mouse ±" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox Text="{Binding MouseJitterPx}" Width="48" />
              <TextBlock Text="px" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Timeline -->
        <Grid>
          <ListBox ItemsSource="{Binding Blocks}" Background="Transparent" BorderThickness="0" Padding="12,8"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Row" CornerRadius="8" Padding="10,7" Margin="0,1" Background="Transparent"
                              BorderThickness="3,0,0,0" BorderBrush="Transparent">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                          <Setter TargetName="Row" Property="Background" Value="{DynamicResource Current}" />
                          <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                          <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                        </DataTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:BlockRow}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Number}" Style="{StaticResource Eyebrow}" Width="34" VerticalAlignment="Center" />
                  <Border Style="{StaticResource Chip}" BorderBrush="{Binding Category, Converter={StaticResource CategoryBrush}}">
                    <TextBlock Text="{Binding Tag}" FontFamily="{StaticResource Mono}" FontSize="10" HorizontalAlignment="Center"
                               Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                  </Border>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="12,0,10,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource TextMuted}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="600" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="No blocks yet. Press Record to capture keyboard and mouse input."
                     Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Visibility>
              <Binding Path="Blocks.Count" Converter="{StaticResource ZeroToVisible}" />
            </TextBlock.Visibility>
          </TextBlock>
        </Grid>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
