<UserControl x:Class="NightLoop.App.Views.MacrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NightLoop.App.ViewModels"
             xmlns:controls="clr-namespace:NightLoop.App.Controls"
             x:Name="Root">
  <UserControl.Resources>
    <Style x:Key="SmallLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SmallBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Width" Value="52" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Margin" Value="8,0,4,0" />
    </Style>
    <!-- Bigger buttons, as in the mockup (44 px tall). -->
    <Style x:Key="Tall" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Margin" Value="10,0,0,0" />
    </Style>
    <Style x:Key="TallPrimary" TargetType="Button" BasedOn="{StaticResource Tall}">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
      <Setter Property="Padding" Value="18,0" />
    </Style>
    <!-- Key chip, e.g. "Ctrl + F5". -->
    <Style x:Key="KeyChip" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MaxWidth" Value="160" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="KeyChipText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSoft}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Round status pill: "Off", "Running", "In editor", "Draft · autosaved". -->
    <Style x:Key="RoundPill" TargetType="Border">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource PanelRaised}" />
    </Style>
    <Style x:Key="PillText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
    <!-- The sliders icon of the options buttons. -->
    <Geometry x:Key="SlidersIcon">M4,6 L14,6 M18,6 L20,6 M4,12 L8,12 M12,12 L20,12 M4,18 L16,18 M14,6 A2,2 0 1 1 18,6 A2,2 0 1 1 14,6 M8,12 A2,2 0 1 1 12,12 A2,2 0 1 1 8,12 M16,18 A2,2 0 1 1 20,18 A2,2 0 1 1 16,18</Geometry>
    <Style x:Key="OptionsButton" TargetType="ToggleButton">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
              <Path Data="{StaticResource SlidersIcon}" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" Width="18" Height="18"
                    Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelRaised}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Dashed tool button in the inspector: "Pick point on screen". -->
    <!-- A program box: looks like a text box, opens File Explorer when clicked. -->
    <Style x:Key="ProgramBox" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Background" Value="{DynamicResource Bg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextSoft}" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Margin" Value="0,14,0,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Rectangle x:Name="Dash" RadiusX="6" RadiusY="6" Stroke="{DynamicResource BorderStrong}" StrokeThickness="1"
                         StrokeDashArray="4 3" SnapsToDevicePixels="True" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,8" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Dash" Property="Stroke" Value="{DynamicResource Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Vertical guide lines in the nesting indent, one per level. -->
    <DrawingBrush x:Key="IndentGuides" TileMode="Tile" Viewport="0,0,22,22" ViewportUnits="Absolute" Viewbox="0,0,22,22" ViewboxUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="0,0,22,22" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="{DynamicResource BorderStrong}">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="6,0,1,22" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- Delete button that asks once: an icon, then "Delete?" in red. -->
    <Style x:Key="ConfirmDelete" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="FontSize" Value="14" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                ScrollChanged="OnScrollChanged">
      <StackPanel Margin="40,36,40,40">
        <!-- Header -->
        <controls:SplitRow>
          <StackPanel>
            <TextBlock Text="MACROS" Style="{StaticResource Eyebrow}" FontSize="12" />
            <TextBlock Text="Macros" Style="{StaticResource PageTitle}" FontSize="34" Margin="0,8,0,8" />
            <TextBlock Text="Build macros from blocks. Run several at once." Style="{StaticResource Muted}" FontSize="15"
                       TextWrapping="Wrap" />
          </StackPanel>
          <Button VerticalAlignment="Bottom" HorizontalAlignment="Left" Style="{StaticResource Tall}" Padding="18,0" Margin="0"
                  Foreground="{DynamicResource Record}" BorderBrush="{DynamicResource DangerBorder}"
                  Command="{Binding StopAllCommand}" ToolTip="{Binding PanicHotkeyText}" Content="{Binding StopAllText}" />
        </controls:SplitRow>

        <!-- Target game banner -->
        <Border Margin="0,24,0,0" Padding="18,14" CornerRadius="10" BorderThickness="1"
                Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentSoftBorder}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Change target" VerticalAlignment="Center"
                    FontWeight="SemiBold" Command="{Binding ChangeTargetCommand}" />
            <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
              <Ellipse Stroke="{DynamicResource AccentLink}" StrokeThickness="2" />
              <Ellipse Width="8" Height="8" Stroke="{DynamicResource AccentLink}" StrokeThickness="2" />
            </Grid>
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" FontSize="14">
              <Run Text="{Binding Games.BannerLead, Mode=OneWay}" /><Run Text="{Binding Games.BannerBold, Mode=OneWay}" FontWeight="Bold" /><Run
                   Text="{Binding Games.BannerTail, Mode=OneWay}" />
            </TextBlock>
          </DockPanel>
        </Border>

        <!-- ================= Loaded macro ================= -->
        <Border x:Name="LoadedCard" Margin="0,24,0,0" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
          <StackPanel>
            <!-- The macro's top bars (name and run buttons, options, Add block, ticked blocks row). With many blocks they
                 stay pinned to the top of the page as it scrolls, like the block editor (code-behind, Settings › Macros). -->
            <StackPanel x:Name="MacroHead" Panel.ZIndex="1" Background="{DynamicResource Panel}" SizeChanged="OnEditorBodySizeChanged">
              <StackPanel.RenderTransform>
                <TranslateTransform x:Name="HeadShift" />
              </StackPanel.RenderTransform>
            <!-- Name, state and sync pills, run buttons -->
            <controls:SplitRow Margin="20,16" Gap="16">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="LOADED MACRO" Style="{StaticResource Eyebrow}" />
                <WrapPanel Margin="0,4,0,0">
                  <TextBox Text="{Binding MacroName, UpdateSourceTrigger=PropertyChanged}" FontSize="18" FontWeight="Bold" Width="220"
                           MinHeight="36" Padding="10,0" Margin="-10,0,6,0" MaxLength="60" Background="Transparent" BorderBrush="Transparent"
                           ToolTip="Macro name" />
                  <Border Margin="0,0,8,0">
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource RoundPill}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SuccessSoft}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding RunStateText}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PillText}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource Success}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                  <Border Margin="0,4,0,4">
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource RoundPill}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SyncKind}" Value="saved">
                            <Setter Property="Background" Value="{DynamicResource SuccessSoft}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding SyncKind}" Value="draft">
                            <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding SyncKind}" Value="saving">
                            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding SyncKind}" Value="error">
                            <Setter Property="Background" Value="{DynamicResource RecordSoft}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding SyncText}" TextTrimming="CharacterEllipsis" MaxWidth="320">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PillText}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SyncKind}" Value="saved">
                              <Setter Property="Foreground" Value="{DynamicResource Success}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SyncKind}" Value="draft">
                              <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SyncKind}" Value="saving">
                              <Setter Property="Foreground" Value="{DynamicResource AccentLink}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SyncKind}" Value="error">
                              <Setter Property="Foreground" Value="{DynamicResource Record}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </WrapPanel>
              </StackPanel>
              <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                <Button Command="{Binding TogglePlayCommand}" MinWidth="88" Margin="0,4,0,4" Content="{Binding PlayText}"
                        ToolTip="{Binding PlayToolTip}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TallPrimary}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource BorderStrong}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                          <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Border Style="{StaticResource KeyChip}" Margin="10,4,0,4" ToolTip="Start / stop key">
                  <TextBlock Text="{Binding PlayHotkeyText}" Style="{StaticResource KeyChipText}" />
                </Border>
                <ToggleButton Style="{StaticResource OptionsButton}" IsChecked="{Binding ShowEditorOptions}" ToolTip="Options for loaded macro"
                              Margin="10,4,0,4" />
              </WrapPanel>
            </controls:SplitRow>

            <!-- Loaded macro options (sliders button) -->
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,18" Background="{DynamicResource Inset}"
                    Visibility="{Binding ShowEditorOptions, Converter={StaticResource BoolToVisible}}">
              <StackPanel>
                <DockPanel>
                  <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding EditorRunAlongside}"
                            ToolTip="Run alongside other macros" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Run alongside other macros" FontWeight="SemiBold" />
                    <TextBlock Text="Off: starting this pauses every other macro." Style="{StaticResource SmallLabel}" Margin="0,2,0,0" />
                  </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,14,0,0">
                  <Button DockPanel.Dock="Right" Content="None" Command="{Binding ClearEditorHotkeyCommand}" IsEnabled="{Binding EditorHasHotkey}"
                          FontSize="13" FontWeight="Normal" MinHeight="44" Margin="8,0,0,0" Background="{DynamicResource Bg}"
                          ToolTip="No start / stop key: the macro only runs from Play" />
                  <Button DockPanel.Dock="Right" Content="{Binding EditorHotkeyLabel}" Command="{Binding CaptureEditorHotkeyCommand}"
                          FontFamily="{StaticResource Mono}" FontSize="13" FontWeight="Normal" MinHeight="44" MaxWidth="280" Background="{DynamicResource Bg}"
                          ToolTip="Click, then press a key. Backspace clears it." />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Start / stop key" FontWeight="SemiBold" />
                    <TextBlock Text="Plays this macro from any window, even when another one is open here. Saved as soon as you pick it. Macros can share a key; it starts them together." Style="{StaticResource SmallLabel}"
                               Margin="0,2,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding EditorHotkeyError}" FontSize="12" Foreground="{DynamicResource Warning}" Margin="0,2,0,0"
                               TextWrapping="Wrap" Visibility="{Binding EditorHotkeyError, Converter={StaticResource TextToVisible}}" />
                  </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,14,0,0">
                  <Border DockPanel.Dock="Right" Style="{StaticResource SegmentBar}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Style="{StaticResource Segment}" GroupName="EditorTrigger" Content="Toggle" MinWidth="72"
                                   IsChecked="{Binding EditorTriggerMode, Converter={StaticResource EqualsParam}, ConverterParameter=toggle}" />
                      <RadioButton Style="{StaticResource Segment}" GroupName="EditorTrigger" Content="Hold" MinWidth="72"
                                   IsChecked="{Binding EditorTriggerMode, Converter={StaticResource EqualsParam}, ConverterParameter=hold}" />
                    </StackPanel>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Trigger" FontWeight="SemiBold" />
                    <TextBlock Text="Toggle: press to start, press to stop. Hold: runs while held." Style="{StaticResource SmallLabel}"
                               Margin="0,2,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,14,0,0">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Text="{Binding RepeatCount}" Style="{StaticResource SmallBox}" Width="70"
                             IsEnabled="{Binding RepeatForever, Converter={StaticResource Not}}" ToolTip="Times to run the whole macro" />
                    <CheckBox Content="Infinite" IsChecked="{Binding RepeatForever}" Margin="10,0,0,0" />
                  </StackPanel>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Repeat" FontWeight="SemiBold" />
                    <TextBlock Text="How many times Play runs the whole macro." Style="{StaticResource SmallLabel}" Margin="0,2,0,0" />
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>

            <!-- Add block: category chips, then the open category's blocks -->
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,16">
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="Add block" Style="{StaticResource SmallLabel}" Margin="0,13,12,0"
                             VerticalAlignment="Top" />
                  <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:PaletteCategory}">
                        <Button Command="{Binding DataContext.ToggleCategoryCommand, ElementName=Root}" CommandParameter="{Binding}"
                                Margin="0,3,6,3" Cursor="Hand">
                          <Button.Template>
                            <ControlTemplate TargetType="Button">
                              <Border x:Name="Bd" CornerRadius="999" BorderThickness="1" BorderBrush="{DynamicResource BorderStrong}"
                                      Background="Transparent" Padding="12,0" MinHeight="36">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                  <Ellipse Width="8" Height="8" Fill="{Binding Color, Converter={StaticResource HexToBrush}}" VerticalAlignment="Center" />
                                  <TextBlock x:Name="Name" Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13"
                                             FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                  <TextBlock Text="{Binding Count}" FontFamily="{StaticResource Mono}" FontSize="11" Margin="8,0,0,0"
                                             VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}" />
                                </StackPanel>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Text}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelRaised}" />
                                  <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                  <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Text}" />
                                </DataTrigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Button.Template>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding PaletteItems}" Margin="0,12,0,0"
                              Visibility="{Binding OpenCategory, Converter={StaticResource NullToVisible}}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <controls:AutoGrid MinItemWidth="190" Gap="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BlockDef}">
                      <Button Command="{Binding DataContext.AddBlockCommand, ElementName=Root}" CommandParameter="{Binding}"
                              Cursor="Hand" Foreground="{DynamicResource Text}" HorizontalContentAlignment="Stretch">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <Grid>
                              <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderStrong}"
                                      Background="{DynamicResource Bg}" />
                              <Border CornerRadius="8,0,0,8" Width="3" HorizontalAlignment="Left"
                                      Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                              <ContentPresenter Margin="14,10,12,10" />
                            </Grid>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelRaised}" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Button.Template>
                        <StackPanel MinHeight="44">
                          <TextBlock FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis">
                            <Run Text="+ " /><Run Text="{Binding Label, Mode=OneWay}" />
                          </TextBlock>
                          <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" LineHeight="17"
                                     TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Options row: humanize, speed, block count -->
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1" Padding="20,12" Background="{DynamicResource Inset}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                  <TextBlock Text="Speed %" Style="{StaticResource SmallLabel}" />
                  <TextBox Text="{Binding SpeedPct}" Style="{StaticResource SmallBox}" Width="60" Margin="10,0,10,0"
                           ToolTip="200 runs twice as fast, 50 at half speed" />
                  <TextBlock Text="{Binding BlockSummary}" Style="{StaticResource Eyebrow}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <WrapPanel>
                  <!-- Ticked blocks: move or delete them together. Shift+click a tick ticks every block in between. -->
                  <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="0,0,12,0" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Style="{StaticResource IconButton}" Width="32" Height="32" Margin="0" Content="&#xE8B3;" ToolTip="{Binding CheckAllToolTip}"
                              Command="{Binding ToggleCheckAllCommand}" />
                      <TextBlock Text="{Binding CheckedText}" Style="{StaticResource SmallLabel}" MinWidth="70" Margin="6,0,6,0" VerticalAlignment="Center"
                                 ToolTip="Tick blocks on the timeline. Shift+click a second tick to select every block between the two." />
                      <Button Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE70E;" ToolTip="Move the selected blocks up"
                              Command="{Binding MoveCheckedUpCommand}" IsEnabled="{Binding HasChecked}" />
                      <Button Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE70D;" ToolTip="Move the selected blocks down"
                              Command="{Binding MoveCheckedDownCommand}" IsEnabled="{Binding HasChecked}" />
                      <Button Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE74D;" ToolTip="Delete the selected blocks. Keys for delete, copy, paste and undo are in Settings › Macros."
                              Command="{Binding DeleteCheckedCommand}" IsEnabled="{Binding HasChecked}" />
                    </StackPanel>
                  </Border>
                  <CheckBox Content="Humanize" IsChecked="{Binding Humanize}" FontWeight="SemiBold" FontSize="13" Margin="0,4,16,4" />
                  <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                    <TextBlock Text="Timing ±" Style="{StaticResource SmallLabel}" />
                    <TextBox Text="{Binding TimingJitterPct}" Style="{StaticResource SmallBox}" IsEnabled="{Binding Humanize}" />
                    <TextBlock Text="%" Style="{StaticResource SmallLabel}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <TextBlock Text="Mouse ±" Style="{StaticResource SmallLabel}" />
                    <TextBox Text="{Binding MouseJitterPx}" Style="{StaticResource SmallBox}" IsEnabled="{Binding Humanize}" />
                    <TextBlock Text="px" Style="{StaticResource SmallLabel}" />
                  </StackPanel>
                </WrapPanel>
              </DockPanel>
            </Border>

            </StackPanel>

            <!-- Timeline + block editor, always side by side (the window shrinks the whole UI instead). With many blocks
                 the editor slides down beside the timeline as the page scrolls (code-behind, Settings › Macros). -->
            <Grid x:Name="EditorBody" SizeChanged="OnEditorBodySizeChanged">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="280" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- Timeline -->
              <Grid MinHeight="200" Margin="0,8">
                <ItemsControl x:Name="Timeline" ItemsSource="{Binding Blocks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BlockRow}">
                      <Grid x:Name="Row" Margin="12,0" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnRowClick"
                            Focusable="True" FocusVisualStyle="{x:Null}">
                        <Border x:Name="RowBg" CornerRadius="8" Background="Transparent" />
                        <Border x:Name="RowBar" CornerRadius="8,0,0,8" Width="3" HorizontalAlignment="Left" Background="Transparent" />
                        <DockPanel Margin="2,0,6,0">
                          <!-- Row actions -->
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Fold a Loop / If / Repeat until: hides the blocks inside. Rows that can't fold keep the space, so the buttons line up. -->
                            <Button x:Name="Fold" Style="{StaticResource IconButton}" Width="34" Height="36" Content="&#xE70D;"
                                    ToolTip="{Binding CollapseToolTip}" Visibility="Hidden"
                                    Command="{Binding DataContext.ToggleCollapseCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            <Button Style="{StaticResource IconButton}" Width="34" Height="36" Content="&#xE8C8;" ToolTip="Duplicate"
                                    Command="{Binding DataContext.DuplicateBlockCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            <Button Style="{StaticResource IconButton}" Width="34" Height="36" Content="&#xE70E;" ToolTip="Move up"
                                    Command="{Binding DataContext.MoveBlockUpCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            <Button Style="{StaticResource IconButton}" Width="34" Height="36" Content="&#xE70D;" ToolTip="Move down"
                                    Command="{Binding DataContext.MoveBlockDownCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            <Button Style="{StaticResource IconButton}" Width="34" Height="36" Content="&#xE74D;" ToolTip="Delete"
                                    Command="{Binding DataContext.DeleteBlockCommand, ElementName=Root}" CommandParameter="{Binding}" />
                          </StackPanel>
                          <!-- Breakpoint dot and on/off -->
                          <Button DockPanel.Dock="Left" Width="28" Height="36" Cursor="Hand" VerticalAlignment="Center"
                                  ToolTip="Breakpoint: Play pauses before this block"
                                  Command="{Binding DataContext.ToggleBreakpointCommand, ElementName=Root}" CommandParameter="{Binding}">
                            <Button.Template>
                              <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                  <Ellipse x:Name="Dot" Width="10" Height="10" Stroke="{DynamicResource BorderStrong}" StrokeThickness="1" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                  <DataTrigger Binding="{Binding Breakpoint}" Value="True">
                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Record}" />
                                    <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Record}" />
                                  </DataTrigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Button.Template>
                          </Button>
                          <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked, Mode=OneWay}" Width="28" Focusable="False"
                                    ToolTip="Select. Shift+click selects every block from the last one you ticked."
                                    PreviewMouseLeftButtonDown="OnRowCheckDown" PreviewMouseLeftButtonUp="OnRowCheckUp"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" />
                          <!-- Number, nesting guides, tag, title and summary -->
                          <Grid MinHeight="44" Margin="8,6,8,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="22" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource TextFaint}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1" Width="{Binding Indent}" Margin="12,-6,0,-6" Background="{StaticResource IndentGuides}" />
                            <Border x:Name="Tag" Grid.Column="2" MinWidth="44" Padding="6,3" CornerRadius="5" BorderThickness="1" Margin="12,0,12,0"
                                    VerticalAlignment="Center" BorderBrush="{Binding Color, Converter={StaticResource HexToBrush}}">
                              <TextBlock Text="{Binding Tag}" FontFamily="{StaticResource Mono}" FontSize="11" HorizontalAlignment="Center"
                                         Foreground="{Binding Color, Converter={StaticResource HexToBrush}}" />
                            </Border>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                              <DockPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"
                                           DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Bottom" />
                                <TextBlock x:Name="Summary" Text="{Binding InlineDetail}" FontFamily="{StaticResource Mono}" FontSize="13"
                                           Foreground="{DynamicResource TextSoft}" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"
                                           ToolTip="{Binding InlineDetail}" />
                              </DockPanel>
                              <TextBlock x:Name="LongText" Text="{Binding DescriptionText}" TextWrapping="Wrap" FontSize="13" LineHeight="19"
                                         Foreground="{DynamicResource TextSoft}" Margin="0,2,0,0" Visibility="Collapsed" />
                              <TextBlock Text="{Binding Note}" FontSize="12" FontStyle="Italic" Foreground="{DynamicResource TextFaint}" Margin="0,2,0,0"
                                         TextTrimming="CharacterEllipsis" Visibility="{Binding Note, Converter={StaticResource TextToVisible}}" />
                            </StackPanel>
                          </Grid>
                        </DockPanel>
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsDescription}" Value="True">
                          <Setter TargetName="LongText" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsStructural}" Value="True">
                          <Setter TargetName="Tag" Property="Background" Value="{DynamicResource Structural}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CanCollapse}" Value="True">
                          <Setter TargetName="Fold" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                          <Setter TargetName="Fold" Property="Content" Value="&#xE76C;" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                          <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                          <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource AccentSoft}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource PanelRaised}" />
                          <Setter TargetName="RowBar" Property="Background" Value="{DynamicResource Accent}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                          <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource Current}" />
                          <Setter TargetName="RowBar" Property="Background" Value="{DynamicResource Accent}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFault}" Value="True">
                          <Setter TargetName="RowBar" Property="Background" Value="{DynamicResource Record}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                          <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                          <Setter TargetName="Summary" Property="TextDecorations" Value="Strikethrough" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No blocks yet. Add one above." Style="{StaticResource Muted}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="20,32"
                           Visibility="{Binding Blocks.Count, Converter={StaticResource ZeroToVisible}}" />
              </Grid>

              <!-- Block editor (inspector) -->
              <Border x:Name="Inspector" Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0" Padding="20"
                      Background="{DynamicResource Inset}" ClipToBounds="True">
                <DockPanel x:Name="InspectorPanel" VerticalAlignment="Top" SizeChanged="OnInspectorSizeChanged">
                  <DockPanel.RenderTransform>
                    <TranslateTransform x:Name="InspectorShift" />
                  </DockPanel.RenderTransform>
                  <Button DockPanel.Dock="Bottom" Content="{Binding SaveText}" Style="{StaticResource TallPrimary}" Margin="0,20,0,0"
                          HorizontalAlignment="Stretch" Command="{Binding SaveCommand}" />
                  <StackPanel>
                    <TextBlock Text="{Binding InspectorEyebrow}" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="{Binding InspectorTitle}" FontSize="17" FontWeight="Bold" Margin="0,14,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding InspectorDescription}" Style="{StaticResource Muted}" FontSize="12" LineHeight="18"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                    <DockPanel Margin="0,14,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
                      <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding SelectedBlock.Enabled}" VerticalAlignment="Center"
                                ToolTip="Turned off, Play skips this block" />
                      <TextBlock Text="Block on" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"
                                 ToolTip="Turned off, Play skips this block" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding InspectorFields}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BlockField}">
                          <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" />
                            <Grid Visibility="{Binding IsText, Converter={StaticResource BoolToVisible}}">
                              <TextBox x:Name="Box" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding MaxLength}"
                                       MinHeight="40" Padding="10,0" FontSize="13" />
                              <TextBlock Text="{Binding Placeholder}" Style="{StaticResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center"
                                         IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                         Visibility="{Binding Value, Converter={StaticResource TextToVisible}, ConverterParameter=invert}" />
                            </Grid>
                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding MaxLength}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" VerticalContentAlignment="Top" Padding="10"
                                     FontSize="13" Visibility="{Binding IsMultiLine, Converter={StaticResource BoolToVisible}}" />
                            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" MinHeight="40"
                                      Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisible}}" />
                            <!-- Program: click for File Explorer, the arrow lists running apps -->
                            <Grid Visibility="{Binding IsProgram, Converter={StaticResource BoolToVisible}}">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <Button Style="{StaticResource ProgramBox}" Command="{Binding BrowseCommand}" ToolTip="{Binding Value}">
                                <DockPanel>
                                  <TextBlock DockPanel.Dock="Right" Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="14"
                                             Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                  <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProgramName}" FontFamily="{StaticResource Mono}" FontSize="13" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasProgram, Converter={StaticResource BoolToVisible}}" />
                                    <TextBlock Text="{Binding Placeholder}" Style="{StaticResource Muted}" FontSize="13" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasProgram, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}" />
                                    <TextBlock Text="{Binding ProgramFolder}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding ProgramFolder, Converter={StaticResource TextToVisible}}" />
                                  </StackPanel>
                                </DockPanel>
                              </Button>
                              <ToggleButton x:Name="RunningPick" Grid.Column="1" IsChecked="{Binding IsPickingRunning}" Width="40" MinHeight="40"
                                            Margin="6,0,0,0" ToolTip="Pick a running app" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <ToggleButton.Template>
                                  <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                            CornerRadius="8">
                                      <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                      <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                      </Trigger>
                                      <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                      </Trigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </ToggleButton.Template>
                              </ToggleButton>
                              <Popup IsOpen="{Binding IsPickingRunning}" PlacementTarget="{Binding ElementName=RunningPick}" Placement="Bottom"
                                     HorizontalOffset="-240" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{DynamicResource PanelRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                        CornerRadius="8" Margin="0,4,0,0" Padding="4" Width="280" MaxHeight="320">
                                  <Grid>
                                    <ListBox ItemsSource="{Binding RunningPrograms}" SelectedItem="{Binding PickedRunning}" Background="Transparent"
                                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                      <ListBox.ItemTemplate>
                                        <DataTemplate>
                                          <StackPanel Margin="6,4">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Exe}" FontFamily="{StaticResource Mono}" FontSize="12"
                                                       Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                                          </StackPanel>
                                        </DataTemplate>
                                      </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="No apps with a window are running." Style="{StaticResource Muted}" Margin="10,8"
                                               Visibility="{Binding RunningPrograms.Count, Converter={StaticResource ZeroToVisible}}" />
                                  </Grid>
                                </Border>
                              </Popup>
                            </Grid>
                            <Button Style="{StaticResource LinkButton}" Content="Clear" HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Command="{Binding ClearProgramCommand}" Visibility="{Binding CanClear, Converter={StaticResource BoolToVisible}}" />
                            <!-- Slider (Wait after click): follows the Settings slider until moved -->
                            <StackPanel Visibility="{Binding IsSlider, Converter={StaticResource BoolToVisible}}">
                              <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SliderText}" FontFamily="{StaticResource Mono}" FontSize="13"
                                           MinWidth="64" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <Slider Minimum="0" Maximum="{Binding SliderMax}" Value="{Binding SliderValue}" TickFrequency="10"
                                        IsSnapToTickEnabled="True" SmallChange="10" LargeChange="100" AutomationProperties.Name="{Binding Label}" />
                              </DockPanel>
                              <TextBlock Text="{Binding SliderNote}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                              <Button Style="{StaticResource LinkButton}" Content="Follow Settings again" HorizontalAlignment="Left" Margin="0,4,0,0"
                                      Command="{Binding UseSettingsValueCommand}" Visibility="{Binding HasOwnValue, Converter={StaticResource BoolToVisible}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding ShowsHint, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}"
                                       Visibility="{Binding Error, Converter={StaticResource TextToVisible}}" />
                          </StackPanel>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMono}" Value="True">
                              <Setter TargetName="Box" Property="FontFamily" Value="{StaticResource Mono}" />
                              <Setter TargetName="Box" Property="FontSize" Value="14" />
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- The picture this block looks for -->
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding InspectorImageText, Converter={StaticResource TextToVisible}}">
                      <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="8"
                              HorizontalAlignment="Left" Visibility="{Binding InspectorImage, Converter={StaticResource NullToVisible}}">
                        <!-- With a click spot (Find & click / Scan & turn), the dot shows it and a click on the picture moves it. -->
                        <Grid x:Name="PicturePreview" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
                              MouseLeftButtonDown="OnPicturePreviewClick">
                          <Grid.Style>
                            <Style TargetType="Grid">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding InspectorCanSetClickSpot}" Value="True">
                                  <Setter Property="Cursor" Value="Cross" />
                                  <Setter Property="ToolTip" Value="Click where in the picture to click once it is found" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Grid.Style>
                          <Image Source="{Binding InspectorImage}" MaxHeight="120" MaxWidth="230" MinHeight="48" MinWidth="48" Stretch="Uniform" StretchDirection="Both"
                                 RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" />
                          <Canvas IsHitTestVisible="False" ClipToBounds="False"
                                  Visibility="{Binding InspectorCanSetClickSpot, Converter={StaticResource BoolToVisible}}">
                            <Ellipse Width="12" Height="12" Stroke="{DynamicResource Accent}" StrokeThickness="2" Fill="#66FFFFFF">
                              <Canvas.Left>
                                <MultiBinding Converter="{StaticResource ShareToOffset}" ConverterParameter="6">
                                  <Binding Path="ActualWidth" ElementName="PicturePreview" />
                                  <Binding Path="InspectorClickX" />
                                </MultiBinding>
                              </Canvas.Left>
                              <Canvas.Top>
                                <MultiBinding Converter="{StaticResource ShareToOffset}" ConverterParameter="6">
                                  <Binding Path="ActualHeight" ElementName="PicturePreview" />
                                  <Binding Path="InspectorClickY" />
                                </MultiBinding>
                              </Canvas.Top>
                            </Ellipse>
                          </Canvas>
                        </Grid>
                      </Border>
                      <TextBlock Text="{Binding InspectorImageText}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding InspectorTools}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:InspectorTool}">
                          <Button Style="{StaticResource ToolButton}" Content="{Binding Label}"
                                  Command="{Binding DataContext.UseToolCommand, ElementName=Root}" CommandParameter="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DockPanel>
              </Border>
            </Grid>
          </StackPanel>
        </Border>

        <!-- ================= Saved macros ================= -->
        <controls:SplitRow Margin="0,24,0,0">
          <WrapPanel VerticalAlignment="Center">
            <TextBlock Text="Saved macros" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding UsedText}" Style="{StaticResource Eyebrow}" FontSize="12" Margin="10,0,10,0" VerticalAlignment="Center" />
            <Border Width="80" Height="6" CornerRadius="3" Background="{DynamicResource BorderStrong}" VerticalAlignment="Center" ClipToBounds="True">
              <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Height="6" BorderThickness="0" Background="Transparent">
                <ProgressBar.Style>
                  <Style TargetType="ProgressBar">
                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding MeterLevel}" Value="high">
                        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding MeterLevel}" Value="full">
                        <Setter Property="Foreground" Value="{DynamicResource Record}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ProgressBar.Style>
              </ProgressBar>
            </Border>
          </WrapPanel>
          <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Left">
            <Grid Width="300" Margin="0,4,0,4">
              <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" Padding="14,0"
                       Background="{DynamicResource Panel}" />
              <TextBlock Text="Search saved macros" Style="{StaticResource Muted}" FontSize="14" Margin="15,0,0,0" VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource TextToVisible}, ConverterParameter=invert}" />
            </Grid>
            <Button Content="+ New group" Command="{Binding NewGroupCommand}" Style="{StaticResource Tall}" Padding="16,0" Margin="8,4,0,4" />
            <Button Content="+ New macro" Command="{Binding NewMacroCommand}" Margin="8,4,0,4">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource TallPrimary}">
                  <Setter Property="Padding" Value="16,0" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAtLimit}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource BorderStrong}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </WrapPanel>
        </controls:SplitRow>

        <!-- New / edit group form -->
        <Border Margin="0,12,0,0" Padding="18" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BorderStrong}"
                Background="{DynamicResource Inset}" Visibility="{Binding IsGroupFormOpen, Converter={StaticResource BoolToVisible}}">
          <StackPanel>
            <TextBlock Text="{Binding GroupFormTitle}" FontSize="15" FontWeight="Bold" />
            <WrapPanel Margin="0,14,0,0">
              <StackPanel Width="300" Margin="0,0,24,8">
                <TextBlock Text="Group name" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" />
                <Grid>
                  <TextBox x:Name="GroupNameBox" Text="{Binding GroupFormName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" MinHeight="44"
                           Padding="12,0" />
                  <TextBlock Text="e.g. Roblox · coin farming" Style="{StaticResource Muted}" Margin="13,0,0,0" VerticalAlignment="Center"
                             IsHitTestVisible="False"
                             Visibility="{Binding Text, ElementName=GroupNameBox, Converter={StaticResource TextToVisible}, ConverterParameter=invert}" />
                </Grid>
              </StackPanel>
              <StackPanel Margin="0,0,0,8">
                <TextBlock Text="Color" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" />
                <WrapPanel>
                  <ItemsControl ItemsSource="{x:Static vm:MainViewModel.GroupColors}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <RadioButton GroupName="GroupColor" ToolTip="{Binding}" Cursor="Hand" Margin="0,0,8,0"
                                     Background="{Binding Converter={StaticResource HexToBrush}}"
                                     Command="{Binding DataContext.PickGroupColorCommand, ElementName=Root}" CommandParameter="{Binding}">
                          <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                              <Grid Width="36" Height="36">
                                <Ellipse Fill="{TemplateBinding Background}" Stroke="{DynamicResource BorderStrong}" StrokeThickness="1" />
                                <Ellipse x:Name="Ring" Margin="1" Stroke="{DynamicResource Inset}" StrokeThickness="3" />
                              </Grid>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                  <Setter TargetName="Ring" Property="Stroke" Value="#FFFFFF" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </RadioButton.Template>
                          <RadioButton.IsChecked>
                            <MultiBinding Converter="{StaticResource StringsEqual}" Mode="OneWay">
                              <Binding />
                              <Binding Path="DataContext.GroupFormColor" ElementName="Root" />
                            </MultiBinding>
                          </RadioButton.IsChecked>
                        </RadioButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                    <TextBlock Text="Custom" Style="{StaticResource SmallLabel}" Margin="0,0,8,0" />
                    <TextBox Text="{Binding GroupFormCustomColor, UpdateSourceTrigger=LostFocus}" Width="90" MinHeight="36" Padding="8,0"
                             FontFamily="{StaticResource Mono}" FontSize="12" MaxLength="7" ToolTip="Any color as #RRGGBB" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBlock Text="Preview" Style="{StaticResource SmallLabel}" Margin="0,0,10,0" />
              <Grid MaxWidth="280">
                <Border CornerRadius="8" Background="{Binding GroupFormColor, Converter={StaticResource HexToBrush}, ConverterParameter=1A}" />
                <Border CornerRadius="8,0,0,8" Width="3" HorizontalAlignment="Left"
                        Background="{Binding GroupFormColor, Converter={StaticResource HexToBrush}}" />
                <StackPanel Orientation="Horizontal" Margin="12,6">
                  <Border Width="10" Height="10" CornerRadius="3" VerticalAlignment="Center"
                          Background="{Binding GroupFormColor, Converter={StaticResource HexToBrush}}" />
                  <TextBlock Text="{Binding GroupPreviewName}" FontSize="13" FontWeight="Bold" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </StackPanel>
            <TextBlock Text="{Binding GroupFormError}" Style="{StaticResource FieldError}"
                       Visibility="{Binding GroupFormError, Converter={StaticResource TextToVisible}}" />
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button Content="{Binding GroupFormSaveText}" Style="{StaticResource TallPrimary}" Margin="0" Command="{Binding SubmitGroupFormCommand}" />
              <Button Content="Cancel" Style="{StaticResource Tall}" Padding="16,0" Margin="8,0,0,0" Command="{Binding CancelGroupFormCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- At the 15-macro limit -->
        <Border Margin="0,12,0,0" Padding="16,12" CornerRadius="10" BorderThickness="1" Background="{DynamicResource RecordSoft}"
                BorderBrush="{DynamicResource DangerBorder}" Visibility="{Binding ShowLimit, Converter={StaticResource BoolToVisible}}">
          <TextBlock Text="{Binding LimitText}" Foreground="{DynamicResource Record}" FontSize="13" TextWrapping="Wrap" />
        </Border>

        <!-- Drafts banner -->
        <Border Margin="0,12,0,0" Padding="16,12" CornerRadius="10" BorderThickness="1"
                Background="{DynamicResource WarningSoft}" BorderBrush="{DynamicResource WarningBorder}"
                Visibility="{Binding DraftCount, Converter={StaticResource ZeroToVisible}, ConverterParameter=invert}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Save all" Command="{Binding SaveAllCommand}" FontSize="13" Margin="12,0,0,0"
                    Foreground="{DynamicResource Warning}" BorderBrush="{DynamicResource WarningBorder}" />
            <TextBlock Text="{Binding DraftBanner}" Foreground="{DynamicResource Warning}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
          </DockPanel>
        </Border>

        <!-- Groups and their macros -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0" ClipToBounds="True">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Sections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GroupSection}">
                  <StackPanel>
                    <!-- Group header -->
                    <Grid MinHeight="48">
                      <Border x:Name="HeadBg" Background="{Binding Color, Converter={StaticResource HexToBrush}, ConverterParameter=1A}"
                              BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" />
                      <Border Width="4" HorizontalAlignment="Left" Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                      <DockPanel Margin="16,0,8,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisible}}">
                          <Button Style="{StaticResource IconButton}" Width="40" Height="40" Content="&#xE70F;" ToolTip="Edit group"
                                  Command="{Binding RenameCommand}" />
                          <Button Command="{Binding DeleteCommand}" ToolTip="Delete group (its macros become ungrouped)">
                            <Button.Style>
                              <Style TargetType="Button" BasedOn="{StaticResource ConfirmDelete}">
                                <Setter Property="Content" Value="&#xE74D;" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding ConfirmingDelete}" Value="True">
                                    <Setter Property="Content" Value="Delete group?" />
                                    <Setter Property="FontFamily" Value="{StaticResource Ui}" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Width" Value="Auto" />
                                    <Setter Property="Padding" Value="12,0" />
                                    <Setter Property="Foreground" Value="{DynamicResource Record}" />
                                    <Setter Property="Background" Value="{DynamicResource RecordSoft}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                        </StackPanel>
                        <Button Command="{Binding ToggleCommand}" Cursor="Hand" ToolTip="Show or hide" Background="Transparent">
                          <Button.Template>
                            <ControlTemplate TargetType="Button">
                              <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                                <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="12"
                                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                  <TextBlock.RenderTransform>
                                    <RotateTransform Angle="90" />
                                  </TextBlock.RenderTransform>
                                </TextBlock>
                                <Border Width="12" Height="12" CornerRadius="4" Margin="12,0,0,0" VerticalAlignment="Center"
                                        Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" MaxWidth="420" />
                                <TextBlock Text="{Binding CountText}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                              </StackPanel>
                              <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                  <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                      <RotateTransform Angle="0" />
                                    </Setter.Value>
                                  </Setter>
                                </DataTrigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Button.Template>
                        </Button>
                      </DockPanel>
                    </Grid>

                    <StackPanel Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}">
                      <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                              Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="No macros here yet. Open a macro's options and pick this group." Style="{StaticResource Muted}"
                                   Margin="36,16,20,16" TextWrapping="Wrap" />
                      </Border>
                      <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vm:SavedMacroRow}">
                            <Grid>
                              <Border Background="{Binding GroupColor, Converter={StaticResource HexToBrush}, ConverterParameter=0D}"
                                      BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" />
                              <Border Width="4" HorizontalAlignment="Left"
                                      Background="{Binding GroupColor, Converter={StaticResource HexToBrush}, ConverterParameter=FF}" />
                              <StackPanel>
                                <DockPanel Margin="20,14">
                                  <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Content="Save" Command="{Binding SaveCommand}" FontSize="13" Margin="8,0,0,0"
                                            Visibility="{Binding HasDraft, Converter={StaticResource BoolToVisible}}" />
                                    <Button Content="Open" Command="{Binding OpenCommand}" FontSize="13" Margin="8,0,0,0"
                                            Visibility="{Binding IsInEditor, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}" />
                                    <Button Command="{Binding DeleteCommand}" ToolTip="Delete">
                                      <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ConfirmDelete}">
                                          <Setter Property="Content" Value="&#xE74D;" />
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConfirmingDelete}" Value="True">
                                              <Setter Property="Content" Value="Delete?" />
                                              <Setter Property="FontFamily" Value="{StaticResource Ui}" />
                                              <Setter Property="FontSize" Value="13" />
                                              <Setter Property="FontWeight" Value="SemiBold" />
                                              <Setter Property="Width" Value="Auto" />
                                              <Setter Property="Padding" Value="14,0" />
                                              <Setter Property="Foreground" Value="{DynamicResource Record}" />
                                              <Setter Property="Background" Value="{DynamicResource RecordSoft}" />
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </Button.Style>
                                    </Button>
                                    <Border Style="{StaticResource KeyChip}" Margin="8,0,0,0" ToolTip="Start / stop key">
                                      <TextBlock Text="{Binding HotkeyChip}" Style="{StaticResource KeyChipText}" />
                                    </Border>
                                    <ToggleButton Style="{StaticResource OptionsButton}" IsChecked="{Binding ShowOptions}" Margin="8,0,0,0"
                                                  ToolTip="Options" />
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsRunning}" Margin="12,0,0,0"
                                              ToolTip="Run this macro" />
                                  </WrapPanel>
                                  <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <WrapPanel>
                                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"
                                                 MaxWidth="420" ToolTip="{Binding Name}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                      <Border Style="{StaticResource RoundPill}" Background="{DynamicResource Accent}" Margin="0,2,6,2"
                                              Visibility="{Binding IsInEditor, Converter={StaticResource BoolToVisible}}">
                                        <TextBlock Text="In editor" Style="{StaticResource PillText}" Foreground="{DynamicResource AccentText}" />
                                      </Border>
                                      <Border Style="{StaticResource RoundPill}" Background="{DynamicResource WarningSoft}" Margin="0,2,6,2"
                                              Visibility="{Binding HasDraft, Converter={StaticResource BoolToVisible}}">
                                        <TextBlock Text="Draft · autosaved" Style="{StaticResource PillText}" Foreground="{DynamicResource Warning}" />
                                      </Border>
                                      <Border Margin="0,2,0,2">
                                        <Border.Style>
                                          <Style TargetType="Border" BasedOn="{StaticResource RoundPill}">
                                            <Style.Triggers>
                                              <DataTrigger Binding="{Binding IsRunningState}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessSoft}" />
                                              </DataTrigger>
                                            </Style.Triggers>
                                          </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StateText}">
                                          <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PillText}">
                                              <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunningState}" Value="True">
                                                  <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                </DataTrigger>
                                              </Style.Triggers>
                                            </Style>
                                          </TextBlock.Style>
                                        </TextBlock>
                                      </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding HotkeyError}" FontSize="12" Foreground="{DynamicResource Warning}" Margin="0,2,0,0"
                                               TextWrapping="Wrap" Visibility="{Binding HotkeyError, Converter={StaticResource TextToVisible}}" />
                                  </StackPanel>
                                </DockPanel>

                                <!-- Per-macro options -->
                                <Border Padding="20,18" Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,1"
                                        Visibility="{Binding ShowOptions, Converter={StaticResource BoolToVisible}}">
                                  <StackPanel>
                                    <DockPanel>
                                      <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding RunAlongside}"
                                                ToolTip="Run alongside other macros" />
                                      <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Run alongside other macros" FontWeight="SemiBold" />
                                        <TextBlock Text="Off: starting this pauses every other macro." Style="{StaticResource SmallLabel}" Margin="0,2,0,0" />
                                      </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,14,0,0">
                                      <Button DockPanel.Dock="Right" Content="None" Command="{Binding ClearHotkeyCommand}" IsEnabled="{Binding HasHotkey}"
                                              FontSize="13" FontWeight="Normal" MinHeight="44" Margin="8,0,0,0" Background="{DynamicResource Bg}"
                                              ToolTip="No start / stop key: the macro only runs from Play" />
                                      <Button DockPanel.Dock="Right" Content="{Binding HotkeyLabel}" Command="{Binding CaptureHotkeyCommand}"
                                              FontFamily="{StaticResource Mono}" FontSize="13" FontWeight="Normal" MinHeight="44" MaxWidth="280"
                                              Background="{DynamicResource Bg}" ToolTip="Click, then press a key. Backspace clears it." />
                                      <TextBlock Text="Start / stop key" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <DockPanel Margin="0,14,0,0">
                                      <Border DockPanel.Dock="Right" Style="{StaticResource SegmentBar}">
                                        <StackPanel Orientation="Horizontal">
                                          <RadioButton Style="{StaticResource Segment}" Content="Toggle" GroupName="{Binding Id}" MinWidth="72"
                                                       IsChecked="{Binding TriggerMode, Converter={StaticResource EqualsParam}, ConverterParameter=toggle}" />
                                          <RadioButton Style="{StaticResource Segment}" Content="Hold" GroupName="{Binding Id}" MinWidth="72"
                                                       IsChecked="{Binding TriggerMode, Converter={StaticResource EqualsParam}, ConverterParameter=hold}" />
                                        </StackPanel>
                                      </Border>
                                      <TextBlock Text="Trigger" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <DockPanel Margin="0,14,0,0">
                                      <ComboBox DockPanel.Dock="Right" MinWidth="200" MaxWidth="280" MinHeight="44" ItemsSource="{Binding GroupChoices}"
                                                SelectedItem="{Binding SelectedGroup}" />
                                      <TextBlock Text="Group" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                  </StackPanel>
                                </Border>
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsGroup}" Value="False">
                      <Setter TargetName="HeadBg" Property="Background" Value="{DynamicResource Inset}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Nothing saved yet. Add blocks, then press Save to account." Style="{StaticResource Muted}"
                       FontSize="14" Margin="20,28" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolToVisible}}" />
            <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="20,28" HorizontalAlignment="Center" TextWrapping="Wrap"
                       Visibility="{Binding HasNoMatch, Converter={StaticResource BoolToVisible}}">
              <Run Text="No saved macros match &#x201C;" /><Run Text="{Binding SearchText, Mode=OneWay}" /><Run Text="&#x201D;." />
            </TextBlock>
            <TextBlock Text="Macros created and stored in Night-loop are assets of Night-loop and aren't owned by the user. See the Terms of Service, section 5."
                       Style="{StaticResource Muted}" FontSize="12" Margin="20,12,20,16" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Toast: the latest message, for a few seconds -->
    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="40,0,40,24" MaxWidth="620" Padding="16,10,8,10"
            CornerRadius="10" BorderThickness="1" Background="{DynamicResource PanelRaised}" BorderBrush="{DynamicResource BorderStrong}"
            Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisible}}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="#000000" />
      </Border.Effect>
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="28" Height="28"
                Margin="10,0,0,0" ToolTip="Close" Command="{Binding HideToastCommand}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
