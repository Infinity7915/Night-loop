<Window x:Class="NightLoop.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NightLoop.App.ViewModels"
        xmlns:views="clr-namespace:NightLoop.App.Views"
        xmlns:controls="clr-namespace:NightLoop.App.Controls"
        Title="Night-loop" Icon="/Assets/icon.png"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" Style="{StaticResource NightWindow}">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:LoadingViewModel}">
      <views:LoadingView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AuthViewModel}">
      <views:AuthView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MainViewModel}">
      <views:MacrosView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar (signed in only) -->
    <Border Width="220" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"
            Visibility="{Binding ShowSidebar, Converter={StaticResource BoolToVisible}}">
      <DockPanel Margin="16,20">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
          <Image Source="/Assets/icon.png" Width="34" Height="34" />
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Night-loop" FontWeight="SemiBold" />
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Eyebrow}" />
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,24,0,0">
          <!-- Icons are Segoe Fluent Icons / MDL2 glyphs: Home, Lightning bolt, Settings. -->
          <RadioButton Style="{StaticResource NavTab}" Content="Home" Tag="&#xE80F;" IsChecked="{Binding IsHomeTab}" />
          <RadioButton Style="{StaticResource NavTab}" Content="Macros" Tag="&#xE945;" IsChecked="{Binding IsMacrosTab}" />
          <RadioButton Style="{StaticResource NavTab}" Content="Settings" Tag="&#xE713;" IsChecked="{Binding IsSettingsTab}" />
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12" VerticalAlignment="Bottom">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                        Visibility="{Binding Updates.CanRestart, Converter={StaticResource BoolToVisible}}">
              <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
              <Button Style="{StaticResource LinkButton}" Content="Update ready · Restart" Margin="6,0,0,0"
                      Command="{Binding Updates.RestartCommand}" />
            </StackPanel>
            <TextBlock Text="SIGNED IN AS" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="{Binding Username}" FontWeight="SemiBold" Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Username}" />
            <TextBlock Text="Offline — reconnecting…" Foreground="{StaticResource Warning}" FontSize="12" Margin="0,4,0,0"
                       Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisible}}" />
            <Button Content="Sign out" Command="{Binding SignOutCommand}" Margin="0,10,0,0" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <Grid />
      </DockPanel>
    </Border>

    <controls:PageHost Grid.Column="1" Content="{Binding CurrentPage}" />
  </Grid>
</Window>
