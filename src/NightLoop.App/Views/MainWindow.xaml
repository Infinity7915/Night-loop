<Window x:Class="NightLoop.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NightLoop.App.ViewModels"
        xmlns:views="clr-namespace:NightLoop.App.Views"
        xmlns:controls="clr-namespace:NightLoop.App.Controls"
        Title="Night-loop" Icon="/Assets/icon.png"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" Style="{StaticResource NightWindow}" Topmost="{Binding AlwaysOnTop}">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:LoadingViewModel}">
      <views:LoadingView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AuthViewModel}">
      <views:AuthView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MainViewModel}">
      <views:MacrosView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar (signed in only) -->
    <Border Width="220" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"
            Visibility="{Binding ShowSidebar, Converter={StaticResource BoolToVisible}}">
      <DockPanel Margin="16,20">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
          <Image Source="/Assets/icon.png" Width="34" Height="34" />
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Night-loop" FontWeight="SemiBold" />
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Eyebrow}" />
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,24,0,0">
          <!-- Icons are Segoe Fluent Icons / MDL2 glyphs: Home, Lightning bolt, Settings. -->
          <RadioButton Style="{StaticResource NavTab}" Content="Home" Tag="&#xE80F;" IsChecked="{Binding IsHomeTab}" />
          <RadioButton Style="{StaticResource NavTab}" Content="Macros" Tag="&#xE945;" IsChecked="{Binding IsMacrosTab}" />
          <RadioButton Style="{StaticResource NavTab}" Content="Settings" Tag="&#xE713;" IsChecked="{Binding IsSettingsTab}" />
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,12" VerticalAlignment="Bottom">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource Success}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsOffline}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource Warning}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Eyebrow}" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="Signed in as" Style="{StaticResource Muted}" Margin="0,10,0,0" />
            <TextBlock Text="{Binding Username}" FontWeight="SemiBold" Margin="0,2,0,0"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Username}" />
            <Button Style="{StaticResource LinkButton}" Content="Update ready · Restart" Margin="0,8,0,0" HorizontalAlignment="Left"
                    Command="{Binding Updates.RestartCommand}"
                    Visibility="{Binding Updates.CanRestart, Converter={StaticResource BoolToVisible}}" />
          </StackPanel>
        </Border>
        <Grid />
      </DockPanel>
    </Border>

    <controls:PageHost Grid.Column="1" Content="{Binding CurrentPage}" />
  </Grid>
</Window>
