<Window x:Class="NightLoop.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NightLoop.App.ViewModels"
        xmlns:views="clr-namespace:NightLoop.App.Views"
        Title="Night-loop" Icon="/Assets/icon.png"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:LoadingViewModel}">
      <views:LoadingView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AuthViewModel}">
      <views:AuthView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MainViewModel}">
      <views:MacrosView />
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar (signed in only) -->
    <Border Width="220" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"
            Visibility="{Binding ShowSidebar, Converter={StaticResource BoolToVisible}}">
      <DockPanel Margin="16,20">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
          <Image Source="/Assets/icon.png" Width="34" Height="34" />
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Night-loop" FontWeight="SemiBold" />
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Eyebrow}" />
          </StackPanel>
        </StackPanel>
        <Border DockPanel.Dock="Top" Margin="0,24,0,0" Background="{StaticResource PanelRaised}" CornerRadius="8" Padding="12,9">
          <TextBlock Text="⚡  Macros" FontWeight="SemiBold" />
        </Border>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12" VerticalAlignment="Bottom">
          <StackPanel>
            <TextBlock Text="SIGNED IN AS" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="{Binding Username}" FontWeight="SemiBold" Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Username}" />
            <TextBlock Text="Offline — reconnecting…" Foreground="{StaticResource Warning}" FontSize="12" Margin="0,4,0,0"
                       Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisible}}" />
            <Button Content="Sign out" Command="{Binding SignOutCommand}" Margin="0,10,0,0" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <Grid />
      </DockPanel>
    </Border>

    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />
  </Grid>
</Window>
