<UserControl x:Class="NightLoop.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="40,32,40,32" MaxWidth="900" HorizontalAlignment="Stretch">
      <TextBlock Text="SETTINGS" Style="{StaticResource Eyebrow}" />
      <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />

      <!-- Updates (schema section 9): GitHub Releases, installed with Velopack -->
      <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,20,0,0">
        <StackPanel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Check now" Style="{StaticResource PrimaryButton}" Command="{Binding Updates.CheckNowCommand}"
                      Visibility="{Binding Updates.CanRestart, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}" />
              <Button Content="Restart to update" Style="{StaticResource PrimaryButton}" Command="{Binding Updates.RestartCommand}"
                      Visibility="{Binding Updates.CanRestart, Converter={StaticResource BoolToVisible}}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Updates" Style="{StaticResource CardTitle}" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                <Run Text="{Binding Updates.VersionText, Mode=OneWay}" /><Run Text=" · checks GitHub Releases on launch, on Refresh and every 4 hours" />
              </TextBlock>
            </StackPanel>
          </DockPanel>

          <Border Background="{StaticResource Bg}" CornerRadius="8" Padding="14,12" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="{Binding Updates.Title}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Updates.Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
              <ProgressBar Margin="0,10,0,0" Value="{Binding Updates.Progress, Mode=OneWay}"
                           IsIndeterminate="{Binding Updates.Stage, Mode=OneWay, Converter={StaticResource IsStage}, ConverterParameter=Checking}"
                           Visibility="{Binding Updates.IsWorking, Converter={StaticResource BoolToVisible}}" />
              <TextBlock Text="What's new" FontWeight="SemiBold" Margin="0,14,0,4"
                         Visibility="{Binding Updates.Notes, Converter={StaticResource TextToVisible}}" />
              <TextBlock Text="{Binding Updates.Notes}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                         Visibility="{Binding Updates.Notes, Converter={StaticResource TextToVisible}}" />
            </StackPanel>
          </Border>
          <Button Style="{StaticResource LinkButton}" Content="All releases on GitHub →" HorizontalAlignment="Left" Margin="0,12,0,0"
                  Command="{Binding Updates.OpenReleasesCommand}" />
        </StackPanel>
      </Border>

      <!-- Account -->
      <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,20,0,0">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Sign out" Style="{StaticResource DangerButton}" VerticalAlignment="Center"
                  Command="{Binding Shell.SignOutCommand}" />
          <StackPanel>
            <TextBlock Text="Account" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
              <Run Text="Signed in as " /><Run Text="{Binding Shell.Username, Mode=OneWay}" Foreground="{StaticResource Text}" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock Text="Changing your username, email, password and two-factor settings is coming in a later update."
                       Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
