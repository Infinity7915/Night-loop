<UserControl x:Class="NightLoop.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NightLoop.App.ViewModels"
             xmlns:controls="clr-namespace:NightLoop.App.Controls">
  <UserControl.Resources>
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="24" />
      <Setter Property="Margin" Value="0,24,0,0" />
    </Style>
    <Style x:Key="AccountRow" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="24,16" />
    </Style>
    <Style x:Key="Tall" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="TallPrimary" TargetType="Button" BasedOn="{StaticResource Tall}">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
      <Setter Property="Padding" Value="18,0" />
    </Style>
    <!-- Dashed button: "+ Add a game", "Pick from running apps". -->
    <Style x:Key="DashedButton" TargetType="ButtonBase">
      <Setter Property="Foreground" Value="{DynamicResource TextSoft}" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <Grid Background="Transparent">
              <Rectangle x:Name="Dash" RadiusX="8" RadiusY="8" Stroke="{DynamicResource BorderStrong}" StrokeThickness="1"
                         StrokeDashArray="4 3" SnapsToDevicePixels="True" />
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Dash" Property="Stroke" Value="{DynamicResource Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Text box with a grey hint while empty. The hint is the Tag. -->
    <Style x:Key="HintBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Background" Value="{DynamicResource Bg}" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="40" MaxWidth="880" HorizontalAlignment="Stretch">
        <TextBlock Text="SETTINGS" Style="{StaticResource Eyebrow}" FontSize="12" />
        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" FontSize="34" Margin="0,8,0,0" />

        <!-- Appearance: theme mode and accent, saved in settings.json on this PC -->
        <Border Style="{StaticResource SectionCard}">
          <StackPanel>
            <TextBlock Text="Appearance" Style="{StaticResource CardTitle}" />
            <TextBlock Text="Color theme, mode, accent color and how the window sits. Saved locally on this PC." Style="{StaticResource Muted}" Margin="0,4,0,0"
                       TextWrapping="Wrap" />
            <controls:SplitRow Margin="0,20,0,0">
              <TextBlock Text="Theme" Style="{StaticResource RowLabel}" />
              <ItemsControl ItemsSource="{Binding Themes}" HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:ThemeOption}">
                    <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left" Margin="0,0,8,8" Padding="3">
                      <RadioButton Style="{StaticResource Segment}" GroupName="ThemePalette" IsChecked="{Binding IsSelected}" ToolTip="{Binding Name}">
                        <StackPanel Orientation="Horizontal">
                          <Grid Width="22" Height="22" Margin="0,0,8,0">
                            <Ellipse Fill="{Binding Preview, Converter={StaticResource HexToBrush}}" Stroke="{DynamicResource BorderStrong}" StrokeThickness="1" />
                            <Ellipse Width="10" Height="10" Fill="{Binding AccentHex, Converter={StaticResource HexToBrush}}" />
                          </Grid>
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                      </RadioButton>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </controls:SplitRow>
            <controls:SplitRow Margin="0,12,0,0">
              <TextBlock Text="Mode" Style="{StaticResource RowLabel}" />
              <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left" IsEnabled="{Binding ModeApplies}"
                      ToolTip="Dark, Light and System change the Night theme. The other themes have their own colors.">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Style="{StaticResource Segment}" GroupName="ThemeMode" Content="Dark"
                               IsChecked="{Binding ThemeMode, Converter={StaticResource EqualsParam}, ConverterParameter=dark}" />
                  <RadioButton Style="{StaticResource Segment}" GroupName="ThemeMode" Content="Light" Margin="4,0,0,0"
                               IsChecked="{Binding ThemeMode, Converter={StaticResource EqualsParam}, ConverterParameter=light}" />
                  <RadioButton Style="{StaticResource Segment}" GroupName="ThemeMode" Content="System" Margin="4,0,0,0"
                               IsChecked="{Binding ThemeMode, Converter={StaticResource EqualsParam}, ConverterParameter=system}" />
                </StackPanel>
              </Border>
            </controls:SplitRow>
            <controls:SplitRow Margin="0,20,0,0">
              <TextBlock Text="Accent color" Style="{StaticResource RowLabel}" />
              <ItemsControl ItemsSource="{Binding Accents}" HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:AccentOption}">
                    <RadioButton Style="{StaticResource Swatch}" GroupName="Accent" ToolTip="{Binding Hex}"
                                 Background="{Binding Hex, Converter={StaticResource HexToBrush}}"
                                 IsChecked="{Binding IsSelected}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </controls:SplitRow>
            <DockPanel Margin="0,20,0,0">
              <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding AlwaysOnTop}" VerticalAlignment="Center"
                        ToolTip="Always on top" Margin="16,0,0,0" />
              <StackPanel>
                <TextBlock Text="Always on top" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="Keeps Night-loop above every other window, games included. Clicks a macro sends where Night-loop sits land on Night-loop, so keep it to one side."
                           Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
            <DockPanel Margin="0,20,0,0">
              <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray}" VerticalAlignment="Center"
                        ToolTip="Keep running in the tray when closed" Margin="16,0,0,0" />
              <StackPanel>
                <TextBlock Text="Keep running in the tray when closed" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="Closing the window hides Night-loop to the notification area so hotkeys and macros keep working. Right-click its icon and pick Exit to quit."
                           Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
            <DockPanel Margin="0,20,0,0">
              <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding RememberWindow}" VerticalAlignment="Center"
                        ToolTip="Remember window size and position" Margin="16,0,0,0" />
              <StackPanel>
                <TextBlock Text="Remember window size and position" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="Night-loop opens where it was, at the size it was, when you last closed it. Off: it opens centered at the default size."
                           Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
            <Button Content="Reset to default size and position" Command="{Binding ResetWindowCommand}" HorizontalAlignment="Left"
                    Margin="0,12,0,0" Padding="14,8" FontSize="13" ToolTip="Moves Night-loop back to the middle of the screen at its default size" />
          </StackPanel>
        </Border>

        <!-- Target game: built-ins in code, added games in games.json -->
        <Border Style="{StaticResource SectionCard}">
          <StackPanel>
            <TextBlock Text="Target game" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,16"
                       Text="Macros only send input while this window is focused. Pick N/A to allow any window. Games you add are saved on this PC." />
            <ItemsControl ItemsSource="{Binding Games.Games}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GameOption}">
                  <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove this game"
                            Width="44" Height="44" Margin="8,0,0,0" Command="{Binding RemoveCommand}"
                            Visibility="{Binding IsUserGame, Converter={StaticResource BoolToVisible}}" />
                    <RadioButton Style="{StaticResource OptionRow}" GroupName="TargetGame" IsChecked="{Binding IsActive}">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"
                                   Margin="14,0,0,0" />
                        <Border DockPanel.Dock="Right" CornerRadius="999" Padding="8,2" Background="{DynamicResource PanelRaised}"
                                VerticalAlignment="Center" Margin="14,0,0,0"
                                Visibility="{Binding IsUserGame, Converter={StaticResource BoolToVisible}}">
                          <TextBlock Text="Saved on this PC" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource TextSoft}" />
                        </Border>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"
                                     TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                        </StackPanel>
                      </DockPanel>
                    </RadioButton>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="+ Add a game" Style="{StaticResource DashedButton}" Margin="0,8,0,0" Command="{Binding Games.StartAddCommand}"
                    Visibility="{Binding Games.IsAdding, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}" />

            <!-- Add a game -->
            <Grid Margin="0,8,0,0" Visibility="{Binding Games.IsAdding, Converter={StaticResource BoolToVisible}}">
              <Rectangle RadiusX="10" RadiusY="10" Fill="{DynamicResource Inset}" Stroke="{DynamicResource BorderStrong}" StrokeThickness="1"
                         StrokeDashArray="4 3" SnapsToDevicePixels="True" />
              <StackPanel Margin="16">
                <controls:AutoGrid MinItemWidth="200" Gap="12" Fit="True">
                  <StackPanel>
                    <TextBlock Text="Game name" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" />
                    <Grid>
                      <TextBox x:Name="GameNameBox" Text="{Binding Games.NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                               Style="{StaticResource HintBox}" MinHeight="40" Padding="10,0" />
                      <TextBlock Text="e.g. Valorant" Style="{StaticResource Muted}" FontSize="14" Margin="11,0,0,0" VerticalAlignment="Center"
                                 IsHitTestVisible="False"
                                 Visibility="{Binding Text, ElementName=GameNameBox, Converter={StaticResource TextToVisible}, ConverterParameter=invert}" />
                    </Grid>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Process name" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" />
                    <Grid>
                      <TextBox x:Name="GameExeBox" Text="{Binding Games.NewExe, UpdateSourceTrigger=PropertyChanged}" MaxLength="120"
                               Style="{StaticResource HintBox}" MinHeight="40" Padding="10,0" FontFamily="{StaticResource Mono}" />
                      <TextBlock Text="e.g. Game.exe" Style="{StaticResource Muted}" FontSize="14" FontFamily="{StaticResource Mono}" Margin="11,0,0,0"
                                 VerticalAlignment="Center" IsHitTestVisible="False"
                                 Visibility="{Binding Text, ElementName=GameExeBox, Converter={StaticResource TextToVisible}, ConverterParameter=invert}" />
                    </Grid>
                  </StackPanel>
                </controls:AutoGrid>
                <Grid HorizontalAlignment="Left" Margin="0,12,0,0">
                  <ToggleButton x:Name="PickApp" Content="Pick from running apps" Style="{StaticResource DashedButton}" MinHeight="40"
                                Padding="14,0" FontSize="13" IsChecked="{Binding Games.IsPickingApp}" />
                  <Popup IsOpen="{Binding Games.IsPickingApp}" PlacementTarget="{Binding ElementName=PickApp}" Placement="Bottom"
                         StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{DynamicResource PanelRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8"
                            Margin="0,4,0,0" Padding="4" MinWidth="280" MaxWidth="460" MaxHeight="320">
                      <Grid>
                        <ListBox ItemsSource="{Binding Games.RunningApps}" SelectedItem="{Binding Games.PickedApp}" Background="Transparent"
                                 BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                          <ListBox.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Margin="6,4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Exe}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="No apps with a window are running." Style="{StaticResource Muted}" Margin="10,8"
                                   Visibility="{Binding Games.RunningApps.Count, Converter={StaticResource ZeroToVisible}}" />
                      </Grid>
                    </Border>
                  </Popup>
                </Grid>
                <TextBlock Text="{Binding Games.AddError}" FontSize="12" Foreground="{DynamicResource Record}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Visibility="{Binding Games.AddError, Converter={StaticResource TextToVisible}}" />
                <WrapPanel Margin="0,12,0,0">
                  <Button Content="Add game" Style="{StaticResource TallPrimary}" Command="{Binding Games.ConfirmAddCommand}" IsDefault="True" />
                  <Button Content="Cancel" Style="{StaticResource Tall}" Margin="8,0,0,0" Command="{Binding Games.CancelAddCommand}" />
                </WrapPanel>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Macros: kept on this PC -->
        <Border Style="{StaticResource SectionCard}">
          <StackPanel>
            <TextBlock Text="Macros" Style="{StaticResource CardTitle}" />
            <TextBlock Text="How new macros start, how the editor scrolls, extra waits while macros play and the editor's shortcut keys. Saved locally on this PC." Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <DockPanel Margin="0,20,0,0">
              <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding StarterSequence}" VerticalAlignment="Center"
                        ToolTip="Starter sequence for new macros" Margin="16,0,0,0" />
              <StackPanel>
                <TextBlock Text="Starter sequence for new macros" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="New macros start with Focus, Resize and Position for the target game, a loop to fill in and a notification at the end."
                           Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
            <DockPanel Margin="0,20,0,0">
              <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding EditorFollowsScroll}" VerticalAlignment="Center"
                        ToolTip="Block editor follows scrolling" Margin="16,0,0,0" />
              <StackPanel>
                <TextBlock Text="Block editor follows scrolling" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="When a macro has more blocks than fit on screen, the bars with Record, Play and Add block stay pinned to the top and the block editor slides down beside the timeline as you scroll, so they're always in sight."
                           Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
            <DockPanel Margin="0,20,0,0">
              <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding LivePicking}" VerticalAlignment="Center"
                        ToolTip="Pick on the live screen" Margin="16,0,0,0" />
              <StackPanel>
                <TextBlock Text="Pick on the live screen" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="When you pick a click spot, color, area or picture on screen, the screen keeps moving instead of freezing. A crosshair, the position and the outline show where you're picking, and pictures are taken the moment you let go."
                           Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>

            <!-- Extra waits while macros play. Both start at 0 (off). -->
            <StackPanel Margin="0,20,0,0">
              <TextBlock Text="Wait after clicks" FontWeight="SemiBold" FontSize="14" />
              <TextBlock Text="Added after Click, Drag, Find &amp; click and Scan &amp; turn blocks. A block can set its own in the block editor; blocks you haven't changed follow this."
                         Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
              <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding WaitAfterClicksText}" FontFamily="{StaticResource Mono}" FontSize="13"
                           MinWidth="72" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                <Slider Minimum="0" Maximum="{Binding WaitMax, Mode=OneTime}" Value="{Binding WaitAfterClicksMs}" TickFrequency="10"
                        IsSnapToTickEnabled="True" SmallChange="10" LargeChange="100" AutomationProperties.Name="Wait after clicks" />
              </DockPanel>
            </StackPanel>
            <StackPanel Margin="0,20,0,0">
              <TextBlock Text="Wait after every block" FontWeight="SemiBold" FontSize="14" />
              <TextBlock Text="Added after every block in every macro. Clicking blocks only get it when their wait after click isn't 0, so quick clicks and drags stay quick."
                         Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
              <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding WaitAfterBlocksText}" FontFamily="{StaticResource Mono}" FontSize="13"
                           MinWidth="72" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                <Slider Minimum="0" Maximum="{Binding WaitMax, Mode=OneTime}" Value="{Binding WaitAfterBlocksMs}" TickFrequency="10"
                        IsSnapToTickEnabled="True" SmallChange="10" LargeChange="100" AutomationProperties.Name="Wait after every block" />
              </DockPanel>
            </StackPanel>

            <!-- Editor shortcuts: click a key, then press the new one. -->
            <TextBlock Text="Editor shortcuts" FontWeight="SemiBold" FontSize="14" Margin="0,28,0,0" />
            <TextBlock Text="Keys for the block editor. Click one, then press the new key. Backspace puts the default back, Esc cancels. A macro whose start key is one of these won't start with it until one of them changes."
                       Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding EditorShortcuts}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:EditorShortcut}">
                  <DockPanel Margin="0,14,0,0">
                    <Button DockPanel.Dock="Right" Content="{Binding KeyLabel}" Command="{Binding CaptureCommand}"
                            FontFamily="{StaticResource Mono}" FontSize="13" FontWeight="Normal" MinHeight="40" MinWidth="170" MaxWidth="280"
                            Margin="16,0,0,0" Background="{DynamicResource Bg}" ToolTip="Click, then press a key. Backspace puts the default back." />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{DynamicResource Warning}" Margin="0,2,0,0" TextWrapping="Wrap"
                                 Visibility="{Binding Error, Converter={StaticResource TextToVisible}}" />
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Account -->
        <Border Style="{StaticResource Card}" Margin="0,24,0,0" DataContext="{Binding Account}" ClipToBounds="True">
          <StackPanel>
            <StackPanel Margin="24,24,24,16">
              <TextBlock Text="Account" Style="{StaticResource CardTitle}" />
              <TextBlock Text="Changing your email or password needs a code sent to your email." Style="{StaticResource Muted}" Margin="0,4,0,0"
                         TextWrapping="Wrap" />
            </StackPanel>

            <Border Style="{StaticResource AccountRow}">
              <controls:SplitRow>
                <StackPanel>
                  <TextBlock Text="Username" Style="{StaticResource Muted}" />
                  <TextBlock Text="{Binding Username}" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding Username}" />
                  <TextBlock Text="{Binding UsernameHint}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding UsernameHintWarns}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
                <Button Content="Change" Style="{StaticResource Tall}" HorizontalAlignment="Left" Command="{Binding ChangeUsernameCommand}"
                        IsEnabled="{Binding CanChangeUsername}" />
              </controls:SplitRow>
            </Border>

            <Border Style="{StaticResource AccountRow}">
              <controls:SplitRow>
                <StackPanel>
                  <TextBlock Text="Email" Style="{StaticResource Muted}" />
                  <TextBlock Text="{Binding Email}" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding Email}" />
                  <TextBlock Text="Verified · two-factor codes go here" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <Button Content="Change" Style="{StaticResource Tall}" HorizontalAlignment="Left" Command="{Binding ChangeEmailCommand}" />
              </controls:SplitRow>
            </Border>

            <Border Style="{StaticResource AccountRow}">
              <controls:SplitRow>
                <StackPanel>
                  <TextBlock Text="Password" Style="{StaticResource Muted}" />
                  <TextBlock Text="••••••••••" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0" />
                  <TextBlock Text="Change it as often as you like" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <Button Content="Change" Style="{StaticResource Tall}" HorizontalAlignment="Left" Command="{Binding ChangePasswordCommand}" />
              </controls:SplitRow>
            </Border>

            <!-- The change being made, right under the rows -->
            <Border x:Name="Editor" Padding="24,20" Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                    Visibility="{Binding Dialog, Converter={StaticResource NullToVisible}}">
              <StackPanel DataContext="{Binding Dialog}">
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" />

                <StackPanel Visibility="{Binding IsCodeStage, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}">
                  <controls:AutoGrid MinItemWidth="220" Gap="12" Fit="True" Margin="0,14,0,0">
                    <StackPanel Visibility="{Binding ShowNewPassword, Converter={StaticResource BoolToVisible}}">
                      <TextBlock Text="Current password" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" />
                      <PasswordBox controls:PasswordBinding.Value="{Binding CurrentPassword, Mode=TwoWay}" MaxLength="128" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowNewValue, Converter={StaticResource BoolToVisible}}">
                      <TextBlock Text="{Binding NewValueLabel}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" />
                      <TextBox Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" MaxLength="254" Style="{StaticResource HintBox}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowNewPassword, Converter={StaticResource BoolToVisible}}">
                      <TextBlock Text="New password" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" />
                      <PasswordBox controls:PasswordBinding.Value="{Binding NewPassword, Mode=TwoWay}" MaxLength="128" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowNewPassword, Converter={StaticResource BoolToVisible}}">
                      <TextBlock Text="Confirm new password" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" />
                      <PasswordBox controls:PasswordBinding.Value="{Binding ConfirmPassword, Mode=TwoWay}" MaxLength="128" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowNewPassword, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}">
                      <TextBlock Text="Current password" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" />
                      <PasswordBox controls:PasswordBinding.Value="{Binding CurrentPassword, Mode=TwoWay}" MaxLength="128" />
                    </StackPanel>
                  </controls:AutoGrid>
                  <TextBlock Text="{Binding Intro}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0" />
                </StackPanel>

                <StackPanel MaxWidth="360" HorizontalAlignment="Left" Margin="0,14,0,0"
                            Visibility="{Binding IsCodeStage, Converter={StaticResource BoolToVisible}}">
                  <TextBlock Text="{Binding Info}" FontSize="13" Foreground="{DynamicResource TextSoft}" TextWrapping="Wrap" />
                  <TextBlock Text="Verification code" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,6" />
                  <Grid>
                    <TextBox x:Name="CodeBox" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" Style="{StaticResource HintBox}"
                             FontFamily="{StaticResource Mono}" FontSize="18" />
                    <TextBlock Text="000000" Style="{StaticResource Muted}" FontFamily="{StaticResource Mono}" FontSize="18" Margin="13,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=CodeBox, Converter={StaticResource TextToVisible}, ConverterParameter=invert}" />
                  </Grid>
                  <Button Style="{StaticResource LinkButton}" Content="Resend code" HorizontalAlignment="Left" Margin="0,8,0,0" FontSize="13"
                          Command="{Binding DataContext.ResendCodeCommand, ElementName=Editor}" />
                </StackPanel>

                <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{DynamicResource Record}" TextWrapping="Wrap" Margin="0,14,0,0"
                           Visibility="{Binding Error, Converter={StaticResource TextToVisible}}" />

                <WrapPanel Margin="0,14,0,0">
                  <Button Content="{Binding SubmitText}" IsDefault="True" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                          Command="{Binding DataContext.SubmitDialogCommand, ElementName=Editor}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource TallPrimary}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsDanger}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Record}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Record}" />
                            <Setter Property="Foreground" Value="White" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <Button Content="Cancel" Style="{StaticResource Tall}" Margin="8,0,0,0" IsCancel="True"
                          Command="{Binding DataContext.CancelDialogCommand, ElementName=Editor}" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Padding="24,12" Background="{DynamicResource SuccessSoft}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                    Visibility="{Binding Notice, Converter={StaticResource TextToVisible}}">
              <TextBlock Text="{Binding Notice}" FontSize="13" Foreground="{DynamicResource Success}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource AccountRow}" Padding="24,18">
              <StackPanel>
                <DockPanel>
                  <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding TwofaEnabled}" VerticalAlignment="Center"
                            ToolTip="Two-factor authentication" Margin="16,0,0,0" />
                  <StackPanel>
                    <TextBlock Text="Two-factor authentication (email)" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="After your password, we email you a 6-digit code to finish signing in."
                               Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </DockPanel>
                <controls:SplitRow Margin="0,14,0,0" Visibility="{Binding TwofaEnabled, Converter={StaticResource BoolToVisible}}">
                  <TextBlock Text="Ask for a code" Style="{StaticResource RowLabel}" />
                  <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Style="{StaticResource Segment}" GroupName="TwofaMode" Content="Every sign-in"
                                   IsChecked="{Binding TwofaMode, Converter={StaticResource EqualsParam}, ConverterParameter=every_signin}" />
                      <RadioButton Style="{StaticResource Segment}" GroupName="TwofaMode" Content="New devices only" Margin="4,0,0,0"
                                   IsChecked="{Binding TwofaMode, Converter={StaticResource EqualsParam}, ConverterParameter=new_devices}" />
                    </StackPanel>
                  </Border>
                </controls:SplitRow>
                <TextBlock Text="{Binding TwofaModeHint}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding TwofaEnabled, Converter={StaticResource BoolToVisible}}" />
                <TextBlock Text="With two-factor off, anyone who has your password can sign in." FontSize="12" Foreground="{DynamicResource Warning}"
                           TextWrapping="Wrap" Margin="0,14,0,0"
                           Visibility="{Binding TwofaEnabled, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource AccountRow}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Sign out" Style="{StaticResource Tall}" Foreground="{DynamicResource Record}"
                        BorderBrush="{DynamicResource DangerBorder}" Command="{Binding SignOutCommand}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <Button Style="{StaticResource LinkButton}" Content="Download my data" Foreground="{DynamicResource TextMuted}" FontSize="13"
                          VerticalAlignment="Center" Command="{Binding DownloadDataCommand}"
                          ToolTip="Saves a text file with your email, username, time used and how many macros you have (not the macros)" />
                  <TextBlock Text="·" Foreground="{DynamicResource TextMuted}" Margin="10,0" VerticalAlignment="Center" />
                  <Button Style="{StaticResource LinkButton}" Content="Delete account" Foreground="{DynamicResource TextMuted}" FontSize="13"
                          VerticalAlignment="Center" Command="{Binding DeleteAccountCommand}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Limits: macros and blocks used, from GET /me/limits -->
        <Border Style="{StaticResource SectionCard}" DataContext="{Binding Shell.Limits}">
          <StackPanel>
            <TextBlock Text="Limits" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="How many macros and blocks your account uses. A message shows in Night-loop when 10 or fewer are left." />
            <TextBlock Text="Couldn't reach the server for your limits. They show here once it answers." Style="{StaticResource Muted}"
                       FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasUsage, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}" />
            <StackPanel Visibility="{Binding HasUsage, Converter={StaticResource BoolToVisible}}">
              <controls:AutoGrid MinItemWidth="240" Gap="24" Margin="0,20,0,0">
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding MacrosText}" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Text="Macros" FontSize="14" />
                </DockPanel>
                <Border Height="6" CornerRadius="3" Background="{DynamicResource BorderStrong}" Margin="0,8,0,0" ClipToBounds="True">
                  <ProgressBar Value="{Binding MacrosPercent, Mode=OneWay}" Height="6" BorderThickness="0" Background="Transparent"
                               Foreground="{DynamicResource Accent}" />
                </Border>
                <TextBlock Text="Macros on your account, drafts included." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding NewMacrosText}" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Text="New macros today" FontSize="14" />
                </DockPanel>
                <Border Height="6" CornerRadius="3" Background="{DynamicResource BorderStrong}" Margin="0,8,0,0" ClipToBounds="True">
                  <ProgressBar Value="{Binding NewMacrosPercent, Mode=OneWay}" Height="6" BorderThickness="0" Background="Transparent"
                               Foreground="{DynamicResource Accent}" />
                </Border>
                <TextBlock Text="Macros created since the last reset." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding BlocksText}" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Text="Blocks" FontSize="14" />
                </DockPanel>
                <Border Height="6" CornerRadius="3" Background="{DynamicResource BorderStrong}" Margin="0,8,0,0" ClipToBounds="True">
                  <ProgressBar Value="{Binding BlocksPercent, Mode=OneWay}" Height="6" BorderThickness="0" Background="Transparent"
                               Foreground="{DynamicResource Accent}" />
                </Border>
                <TextBlock Text="Blocks in all your macros together." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding BlocksTodayText}" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Text="Blocks placed today" FontSize="14" />
                </DockPanel>
                <Border Height="6" CornerRadius="3" Background="{DynamicResource BorderStrong}" Margin="0,8,0,0" ClipToBounds="True">
                  <ProgressBar Value="{Binding BlocksTodayPercent, Mode=OneWay}" Height="6" BorderThickness="0" Background="Transparent"
                               Foreground="{DynamicResource Accent}" />
                </Border>
                <TextBlock Text="New blocks you've added, pasted or recorded today." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
              </StackPanel>
              </controls:AutoGrid>
              <TextBlock Text="{Binding ResetText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,18,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Updates (schema section 9): GitHub Releases, installed with Velopack -->
        <Border Style="{StaticResource SectionCard}">
          <StackPanel>
            <controls:SplitRow>
              <StackPanel>
                <TextBlock Text="Updates" Style="{StaticResource CardTitle}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap">
                  <Run Text="{Binding Updates.VersionText, Mode=OneWay}" /><Run Text=" · checks GitHub Releases on launch" />
                </TextBlock>
              </StackPanel>
              <Grid HorizontalAlignment="Left">
                <Button Content="Check now" Style="{StaticResource TallPrimary}" Command="{Binding Updates.CheckNowCommand}"
                        Visibility="{Binding Updates.CanRestart, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}" />
                <Button Content="Restart to update" Style="{StaticResource TallPrimary}" Command="{Binding Updates.RestartCommand}"
                        Visibility="{Binding Updates.CanRestart, Converter={StaticResource BoolToVisible}}" />
              </Grid>
            </controls:SplitRow>

            <Border Background="{DynamicResource Inset}" CornerRadius="8" Padding="14,12" Margin="0,16,0,0"
                    Visibility="{Binding Updates.HasStatus, Converter={StaticResource BoolToVisible}}">
              <StackPanel>
                <TextBlock Text="{Binding Updates.Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Updates.Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <ProgressBar Margin="0,10,0,0" Value="{Binding Updates.Progress, Mode=OneWay}"
                             IsIndeterminate="{Binding Updates.Stage, Mode=OneWay, Converter={StaticResource IsStage}, ConverterParameter=Checking}"
                             Visibility="{Binding Updates.IsWorking, Converter={StaticResource BoolToVisible}}" />
                <TextBlock Text="What's new" FontWeight="SemiBold" Margin="0,14,0,4"
                           Visibility="{Binding Updates.Notes, Converter={StaticResource TextToVisible}}" />
                <TextBlock Text="{Binding Updates.Notes}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Visibility="{Binding Updates.Notes, Converter={StaticResource TextToVisible}}" />
                <Button Style="{StaticResource LinkButton}" Content="All releases on GitHub →" HorizontalAlignment="Left" Margin="0,12,0,0"
                        FontSize="13" Command="{Binding Updates.OpenReleasesCommand}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
