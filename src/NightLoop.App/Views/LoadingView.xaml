<UserControl x:Class="NightLoop.App.Views.LoadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
    <Image Source="{DynamicResource AppIcon}" Width="96" Height="96" />
    <TextBlock Text="Night-loop" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,0" />
    <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,0"
               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
    <ProgressBar IsIndeterminate="True" Height="3" Margin="60,18,60,0" Foreground="{DynamicResource Accent}"
                 Background="{DynamicResource Panel}" BorderThickness="0"
                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
    <Border Style="{StaticResource Card}" Padding="16" Margin="0,20,0,0"
            Visibility="{Binding Error, Converter={StaticResource TextToVisible}}">
      <StackPanel>
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button Command="{Binding UpdateNowCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"
                  Visibility="{Binding OfferUpdate, Converter={StaticResource BoolToVisible}}">
            <TextBlock Text="Update now" Foreground="{DynamicResource AccentText}" />
          </Button>
          <Button Command="{Binding RetryCommand}" Style="{StaticResource PrimaryButton}" Margin="0">
            <TextBlock Text="Retry" Foreground="{DynamicResource AccentText}" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
