<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NightLoop.Engine</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Runs macros. No UI and no Windows code: input, screen capture, text reading and windows come in through interfaces (IInputSender, IScreenCapture, ITextReader, IWindowService), so the PC app (NightLoop.Engine.Windows) and the Android app share it, and it can be unit-tested with fakes.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NightLoop.Contracts\NightLoop.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NightLoop.Engine.Tests" />
    <InternalsVisibleTo Include="NightLoop.Engine.Windows" />
  </ItemGroup>
</Project>
