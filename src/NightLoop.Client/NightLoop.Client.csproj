    <ProjectReference Include="..\NightLoop.LocalData\NightLoop.LocalData.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NightLoop.Client.Tests" />
  </ItemGroup>
</Project>
