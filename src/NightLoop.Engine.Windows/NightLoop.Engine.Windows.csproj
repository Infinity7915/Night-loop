<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Same namespaces as before the split (NightLoop.Engine.Input etc.), so callers didn't change. -->
    <RootNamespace>NightLoop.Engine</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>The Windows side of the engine: SendInput, screen capture, windows and hotkeys (CsWin32).</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NightLoop.Engine\NightLoop.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NightLoop.Engine.Tests" />
  </ItemGroup>
</Project>
